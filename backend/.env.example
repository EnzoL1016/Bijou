PORT=3000

# DB_HOST lo pisa docker-compose.yml automáticamente (usa el nombre del servicio "mysql")
DB_HOST=mysql
DB_USER=lody_app
DB_PASSWORD=cambiar_esto_tambien
DB_PORT=3306
DB_NAME=lody_arte

# Panel admin
ADMIN_USER=cambiar_usuario
ADMIN_PASSWORD=cambiar_password_fuerte

# JWT
JWT_SECRET=generar_un_secreto_largo_y_random

# MercadoPago (token nuevo, después de rotar el que estaba expuesto)
MP_ACCESS_TOKEN=

# Gmail para envío de emails
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_EMAIL=

# Datos bancarios mostrados al cliente
CBU=
MP_ALIAS=
TITULAR_CUENTA=

# URLs (ajustar al dominio real del VPS)
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost/api
